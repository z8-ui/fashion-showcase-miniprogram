.product-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.img-wrap {
  position: relative;
}

.product-img {
  width: 100%;
  height: 340rpx;
  display: block;
  background: #F2F3F5;
}

.vid-badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.product-info {
  padding: 16rpx 20rpx 20rpx;
}

.product-name {
  font-size: 27rpx;
  color: #222;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-sizes {
  font-size: 22rpx;
  color: #FF6B00;
  margin-top: 8rpx;
}
