.page {
  padding: 20rpx 24rpx 40rpx;
}

/* 搜索模式提示 */
.search-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

/* 组别小卡片(2列) */
.group-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.group-card {
  width: 48.5%;
  background: #fff;
  border-radius: 20rpx;
  padding: 44rpx 0 36rpx;
  text-align: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.group-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-top: 18rpx;
}
.group-sub {
  font-size: 22rpx;
  color: #FF6B00;
  margin-top: 10rpx;
}

/* 组别切换 chips(横向滚动) */
.group-chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.group-chip {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #F4F5F7;
  font-size: 25rpx;
  color: #333;
}
.group-chip-active {
  background: #FFF3E6;
  color: #FF6B00;
  border: 2rpx solid #FF6B00;
  font-weight: 600;
}
.group-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 20rpx;
}
.group-title-sub {
  font-size: 26rpx;
  font-weight: 400;
  color: #FF6B00;
}

/* 小分组筛选 chips(第二行, 浅色区分于组别 chips) */
.subgroup-chips {
  white-space: nowrap;
  margin-bottom: 20rpx;
}
.subgroup-chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 30rpx;
  background: #F0F4FF;
  font-size: 24rpx;
  color: #555;
}
.subgroup-chip-active {
  background: #E3F0FF;
  color: #2F6BFF;
  border: 2rpx solid #2F6BFF;
  font-weight: 600;
}

/* 双列网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-grid product-card {
  width: 48.5%;
}

/* 空态 */
.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}
.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-tip {
  display: block;
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

/* 加载更多提示 */
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  padding: 24rpx 0 12rpx;
}
